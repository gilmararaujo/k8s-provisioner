{
 "panels": [
  {
   "id": 1700,
   "type": "row",
   "title": "Storage \u2014 persistent volumes, claims, NFS export",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 1701,
   "type": "stat",
   "title": "PVs bound",
   "description": "PersistentVolumes in the Bound phase (kube-state-metrics).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(kube_persistentvolume_status_phase{phase=\"Bound\"}) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1702,
   "type": "stat",
   "title": "PVs failed / pending",
   "description": "PersistentVolumes stuck in Failed or Pending. Anything above zero needs attention.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(kube_persistentvolume_status_phase{phase=~\"Failed|Pending\"}) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1703,
   "type": "stat",
   "title": "Bound PVCs",
   "description": "PersistentVolumeClaims the workloads are using.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(kube_persistentvolumeclaim_info) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "0",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1704,
   "type": "stat",
   "title": "Storage node",
   "description": "Whether node_exporter on the storage node (which backs every PV over NFS) is reporting.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max(up{job=\"storage-node\"}) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "Down",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red"
        },
        "1": {
         "text": "Up",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 1705,
   "type": "gauge",
   "title": "NFS export free",
   "description": "Free space on the filesystem backing /exports/k8s-volumes on the storage node.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * node_filesystem_avail_bytes{job=\"storage-node\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{job=\"storage-node\",mountpoint=\"/\",fstype!=\"rootfs\"}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "noValue": "N/A",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 10
       },
       {
        "color": "green",
        "value": 20
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1706,
   "type": "timeseries",
   "title": "NFS export free space",
   "description": "Absolute free bytes on the storage node's export filesystem over time.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "node_filesystem_avail_bytes{job=\"storage-node\",mountpoint=\"/\",fstype!=\"rootfs\"}",
     "refId": "A",
     "instant": false,
     "range": true,
     "legendFormat": "free"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1707,
   "type": "timeseries",
   "title": "Storage node disk throughput",
   "description": "Read/write throughput on the storage node's disks (loop devices excluded).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_read_bytes_total{job=\"storage-node\",device!~\"loop.*\"}[5m])",
     "refId": "A",
     "instant": false,
     "range": true,
     "legendFormat": "{{device}} read"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(node_disk_written_bytes_total{job=\"storage-node\",device!~\"loop.*\"}[5m])",
     "refId": "B",
     "instant": false,
     "range": true,
     "legendFormat": "{{device}} write"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "lineWidth": 1,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": []
   }
  },
  {
   "id": 1708,
   "type": "bargauge",
   "title": "Persistent volume claim usage",
   "description": "Used space per PVC as a share of its capacity (kubelet volume stats). Watch for claims nearing full.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * (1 - kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes)",
     "refId": "A",
     "instant": true,
     "range": false,
     "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}"
    }
   ],
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  }
 ]
}

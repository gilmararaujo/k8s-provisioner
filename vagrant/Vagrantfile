require 'yaml'
settings = YAML.load_file(File.join(File.dirname(__FILE__), 'settings.yaml'))

# The provisioner config is the single source of truth for the lab domain and
# the versions of what runs on the storage node outside the cluster.
provisioner_config = YAML.load_file(File.join(File.dirname(__FILE__), '..', 'config.yaml'))
LAB_DOMAIN      = provisioner_config.dig('dns', 'domain').to_s.empty? ? 'lab.internal' : provisioner_config.dig('dns', 'domain')
ETCD_VERSION    = provisioner_config.dig('versions', 'etcd') || 'v3.7.3'
COREDNS_VERSION = provisioner_config.dig('versions', 'coredns') || '1.15.0'
NODE_EXPORTER_VERSION = provisioner_config.dig('versions', 'node_exporter') || 'v1.12.1'
SEAWEEDFS_VERSION = provisioner_config.dig('versions', 'seaweedfs') || '4.53'
S3_PORT       = (provisioner_config.dig('backup', 's3_port') || 8333).to_s
BUCKET_ETCD   = provisioner_config.dig('backup', 'buckets', 'etcd') || 'etcd-backups'
BUCKET_VELERO = provisioner_config.dig('backup', 'buckets', 'velero') || 'velero'
LAB_TIMEZONE    = provisioner_config.dig('cluster', 'timezone').to_s.empty? ? 'UTC' : provisioner_config.dig('cluster', 'timezone')
LAB_HOSTS       = settings['vm'].map { |v| "#{v['ip']} #{v['name']}" }.join("\n")

# Display-name mapping for VirtualBox
DISPLAY_NAMES = {
  "storage" => "Storage",
  "controlplane" => "Master",
  "node01" => "Node01",
  "node02" => "Node02"
}

# NFS Server IP
NFS_SERVER_IP = "192.168.56.20"

Vagrant.configure("2") do |config|
  config.vm.box = settings['box_name']
  config.vm.box_check_update = true

  # Detect architecture for Linux binary
  ARCH = case `uname -m`.strip
         when 'arm64', 'aarch64' then 'arm64'
         else 'amd64'
         end

  # Build the Go binary once before provisioning the control plane.
  # Using only_on ensures a single build regardless of whether the user
  # runs "vagrant up" (sequential) or "vagrant up --parallel".
  config.trigger.before [:up, :provision], only_on: "controlplane" do |trigger|
    trigger.name = "Building k8s-provisioner binary for linux-#{ARCH}"
    trigger.run = { inline: "bash -c 'cd .. && make build-linux-#{ARCH}'" }
  end

  settings['vm'].each do |vm_config|
    vm_display_name = DISPLAY_NAMES[vm_config['name']] || vm_config['name']
    vm_role = vm_config['role'] || 'worker'

    config.vm.define vm_config['name'], primary: (vm_config['name'] == "controlplane") do |vm|
      vm.vm.hostname = vm_config['name']
      vm.vm.network "private_network", ip: vm_config['ip']

      # Synced folders (Kubernetes VMs only)
      if vm_role != "storage"
        vm.vm.synced_folder ".", "/vagrant", type: "virtualbox"
        vm.vm.synced_folder "..", "/opt/k8s-provisioner", type: "virtualbox"
      end

      vm.vm.provider "virtualbox" do |vb|
        vb.name   = vm_display_name
        vb.memory = vm_config['memory']
        vb.cpus   = vm_config['cpus']
        vb.gui    = false
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      end

      # Ensure promiscuous mode after the VM starts (up, reload, resume)
      [:up, :reload, :resume].each do |action|
        vm.trigger.after action do |trigger|
          trigger.name = "Enable promiscuous mode for #{vm_display_name}"
          trigger.run = { inline: "VBoxManage controlvm '#{vm_display_name}' nicpromisc2 allow-all" }
          trigger.on_error = :continue
        end
      end

      # Base provisioning: timezone, /etc/hosts and tools. The timezone is set
      # here so the storage node (not provisioned by the Go binary) gets it too.
      vm.vm.provision "shell", inline: <<-SHELL
        set -e
        timedatectl set-timezone '#{LAB_TIMEZONE}'
        apt-get update -y
        apt-get install -y curl netcat-openbsd nfs-common vim bash-completion

        # /etc/hosts
        echo "192.168.56.20 storage" >> /etc/hosts
        echo "192.168.56.10 controlplane" >> /etc/hosts
        echo "192.168.56.11 node01" >> /etc/hosts
        echo "192.168.56.12 node02" >> /etc/hosts

        # Configure vim for YAML/Kubernetes
        cat > /etc/vim/vimrc.local <<'VIMRC'
" Kubernetes/YAML friendly vim configuration
syntax on
set tabstop=2
set shiftwidth=2
set expandtab
set autoindent
set smartindent
set number
set cursorline
set paste
filetype plugin indent on
autocmd FileType yaml setlocal ts=2 sts=2 sw=2 expandtab
VIMRC

        # Copy to the vagrant user
        mkdir -p /home/vagrant
        cp /etc/vim/vimrc.local /home/vagrant/.vimrc
        chown vagrant:vagrant /home/vagrant/.vimrc

        # Copy to root
        cp /etc/vim/vimrc.local /root/.vimrc
      SHELL

      # Role-specific provisioning
      case vm_role
      when "storage"
        vm.vm.provision "shell", inline: <<-SHELL
          set -e
          echo "=== Configuring NFS Server ==="

          # Install NFS server
          apt-get install -y nfs-kernel-server

          # Create export directories
          mkdir -p /exports/k8s-volumes
          mkdir -p /exports/k8s-volumes/pv01
          mkdir -p /exports/k8s-volumes/pv02
          mkdir -p /exports/k8s-volumes/pv03
          mkdir -p /exports/k8s-volumes/karpor-etcd
          mkdir -p /exports/k8s-volumes/karpor-elasticsearch
          mkdir -p /exports/k8s-volumes/ollama
          chmod -R 777 /exports

          # Configure exports
          cat > /etc/exports <<EOF
/exports/k8s-volumes 192.168.56.0/24(rw,sync,no_subtree_check,no_root_squash)
EOF

          # Restart NFS
          exportfs -ra
          systemctl restart nfs-kernel-server
          systemctl enable nfs-kernel-server

          echo "=== NFS Server configured ==="
          echo "Exports:"
          exportfs -v
        SHELL

        vm.vm.provision "shell", inline: <<-SHELL
          set -e
          echo "=== Installing HashiCorp Vault ==="

          VAULT_VERSION="2.2.1"
          VM_ARCH=$(dpkg --print-architecture)
          apt-get install -y unzip curl

          curl -fsSL "https://releases.hashicorp.com/vault/${VAULT_VERSION}/vault_${VAULT_VERSION}_linux_${VM_ARCH}.zip" \
            -o /tmp/vault.zip
          unzip -o /tmp/vault.zip -d /usr/local/bin/
          rm /tmp/vault.zip
          chmod +x /usr/local/bin/vault
          vault --version

          # User and directories
          useradd --system --home /etc/vault.d --shell /bin/false vault 2>/dev/null || true
          mkdir -p /etc/vault.d /opt/vault/data
          chown -R vault:vault /opt/vault

          # TLS: a dedicated CA for Vault, generated here because Vault starts before
          # the cluster (and its cert-manager lab CA) exists. Only generated once, so
          # re-provisioning keeps the CA the host and the cluster already trust.
          # The server cert stays within Apple's 825-day limit for private CAs.
          TLS_DIR=/etc/vault.d/tls
          mkdir -p $TLS_DIR
          if [ ! -f $TLS_DIR/ca.crt ]; then
            apt-get install -y openssl
            openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
              -keyout $TLS_DIR/ca.key -out $TLS_DIR/ca.crt \
              -subj "/CN=k8s-lab Vault CA" \
              -addext "basicConstraints=critical,CA:TRUE" \
              -addext "keyUsage=critical,keyCertSign,cRLSign"
            openssl req -newkey rsa:2048 -sha256 -nodes \
              -keyout $TLS_DIR/vault.key -out /tmp/vault.csr \
              -subj "/CN=storage"
            cat > /tmp/vault-ext.cnf <<'EXT'
subjectAltName=IP:#{NFS_SERVER_IP},IP:127.0.0.1,DNS:storage,DNS:storage.#{LAB_DOMAIN},DNS:vault.#{LAB_DOMAIN},DNS:localhost
extendedKeyUsage=serverAuth
keyUsage=critical,digitalSignature,keyEncipherment
basicConstraints=critical,CA:FALSE
EXT
            openssl x509 -req -in /tmp/vault.csr -sha256 -days 825 \
              -CA $TLS_DIR/ca.crt -CAkey $TLS_DIR/ca.key -CAcreateserial \
              -out $TLS_DIR/vault.crt -extfile /tmp/vault-ext.cnf
            rm -f /tmp/vault.csr /tmp/vault-ext.cnf
          fi
          chown root:root $TLS_DIR/ca.key && chmod 600 $TLS_DIR/ca.key
          chown vault:vault $TLS_DIR/vault.key $TLS_DIR/vault.crt && chmod 600 $TLS_DIR/vault.key
          chmod 644 $TLS_DIR/ca.crt $TLS_DIR/vault.crt

          # Vault CLI defaults on this node
          cat > /etc/profile.d/vault.sh <<'VAULTENV'
export VAULT_ADDR=https://127.0.0.1:8200
export VAULT_CACERT=/etc/vault.d/tls/ca.crt
VAULTENV

          # Vault configuration
          cat > /etc/vault.d/vault.hcl <<'VAULTCONF'
storage "file" {
  path = "/opt/vault/data"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/etc/vault.d/tls/vault.crt"
  tls_key_file  = "/etc/vault.d/tls/vault.key"
}

api_addr     = "https://#{NFS_SERVER_IP}:8200"
cluster_addr = "https://#{NFS_SERVER_IP}:8201"
ui           = true
VAULTCONF
          chown vault:vault /etc/vault.d/vault.hcl
          chmod 640 /etc/vault.d/vault.hcl

          # Systemd service
          cat > /etc/systemd/system/vault.service <<'VAULTSERVICE'
[Unit]
Description=HashiCorp Vault
Documentation=https://developer.hashicorp.com/vault/docs
After=network-online.target
Wants=network-online.target

[Service]
User=vault
Group=vault
ExecStart=/usr/local/bin/vault server -config=/etc/vault.d/vault.hcl
ExecReload=/bin/kill --signal HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
LimitMEMLOCK=infinity
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
VAULTSERVICE

          systemctl daemon-reload
          systemctl enable vault
          systemctl start vault

          # Auto-unseal: after a reboot or suspend/resume Vault comes back sealed.
          # A timer reads the stored unseal keys and unseals, so the API server's
          # KMS dependency (etcd encryption at rest) never waits on a manual
          # unseal. Lab-grade: the keys live on this node (root-only), which does
          # not widen the threat model the encryption addresses (a stolen etcd
          # snapshot). Production would use a cloud or Transit auto-unseal seal.
          cat > /usr/local/bin/vault-unseal.sh <<'VAULTUNSEAL'
#!/usr/bin/env bash
set -uo pipefail
export VAULT_ADDR=https://127.0.0.1:8200
export VAULT_CACERT=/etc/vault.d/tls/ca.crt
INIT=/etc/vault.d/vault-init.json
[ -f "$INIT" ] || { echo "vault-init.json absent; Vault not initialized yet"; exit 0; }
status() { vault status -format=json 2>/dev/null; }
field()  { printf '%s' "$1" | python3 -c "import json,sys;print(json.load(sys.stdin)[\"$2\"])" 2>/dev/null; }
s=""
for _ in $(seq 1 30); do
  s=$(status)
  [ -n "$s" ] && [ -n "$(field "$s" sealed)" ] && break
  s=""; sleep 2
done
[ -n "$s" ] || { echo "vault API not reachable; leaving for the next timer tick"; exit 0; }
[ "$(field "$s" initialized)" = "True" ] || { echo "vault not initialized yet"; exit 0; }
[ "$(field "$s" sealed)" = "False" ] && { echo "vault already unsealed"; exit 0; }
while IFS= read -r key; do
  vault operator unseal "$key" >/dev/null 2>&1
  s=$(status)
  [ "$(field "$s" sealed)" = "False" ] && break
done < <(python3 -c 'import json;print("\n".join(json.load(open("/etc/vault.d/vault-init.json"))["keys"][:3]))')
if [ "$(field "$s" sealed)" = "False" ]; then echo "vault unsealed"; else echo "vault still sealed after applying stored keys" >&2; exit 1; fi
VAULTUNSEAL
          chmod 755 /usr/local/bin/vault-unseal.sh

          cat > /etc/systemd/system/vault-unseal.service <<'VAULTUNSEALSVC'
[Unit]
Description=Auto-unseal the lab Vault
After=vault.service
Wants=vault.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vault-unseal.sh
VAULTUNSEALSVC

          cat > /etc/systemd/system/vault-unseal.timer <<'VAULTUNSEALTMR'
[Unit]
Description=Ensure the lab Vault stays unsealed (boot, resume, crash-restart)

[Timer]
OnBootSec=15s
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
VAULTUNSEALTMR

          systemctl enable --now vault-unseal.timer

          echo "=== Vault started at https://#{NFS_SERVER_IP}:8200 (CA: /etc/vault.d/tls/ca.crt) ==="
          echo "=== UI available at https://#{NFS_SERVER_IP}:8200/ui ==="
        SHELL

        # Lab DNS: etcd + CoreDNS serving #{LAB_DOMAIN} (records from ExternalDNS)
        vm.vm.provision "lab-dns", type: "shell", path: "scripts/storage-dns.sh", env: {
          "DOMAIN"          => LAB_DOMAIN,
          "STORAGE_IP"      => NFS_SERVER_IP,
          "ETCD_VERSION"    => ETCD_VERSION,
          "COREDNS_VERSION" => COREDNS_VERSION,
          "LAB_HOSTS"       => LAB_HOSTS
        }

        # node_exporter: host + NFS-export metrics for the Storage dashboard
        # (Prometheus job "storage-node"; the storage node is outside the cluster).
        vm.vm.provision "storage-node-exporter", type: "shell", path: "scripts/storage-node-exporter.sh", env: {
          "NODE_EXPORTER_VERSION" => NODE_EXPORTER_VERSION
        }

        # SeaweedFS S3: the backup object store (etcd snapshots + Velero), outside
        # the cluster so backups survive a `vagrant destroy`.
        vm.vm.provision "storage-seaweedfs", type: "shell", path: "scripts/storage-seaweedfs.sh", env: {
          "SEAWEEDFS_VERSION" => SEAWEEDFS_VERSION,
          "STORAGE_IP"        => NFS_SERVER_IP,
          "S3_PORT"           => S3_PORT,
          "BUCKET_ETCD"       => BUCKET_ETCD,
          "BUCKET_VELERO"     => BUCKET_VELERO
        }

      when "controlplane", "worker"
        # Mount NFS on the Kubernetes nodes
        vm.vm.provision "shell", inline: <<-SHELL
          set -e
          echo "=== Mounting NFS ==="

          # Wait for the NFS server to become available
          for i in {1..30}; do
            if showmount -e #{NFS_SERVER_IP} &>/dev/null; then
              echo "NFS server available!"
              break
            fi
            echo "Waiting for NFS server... ($i/30)"
            sleep 5
          done

          # Create mount point
          mkdir -p /mnt/nfs-storage

          # Mount NFS
          mount -t nfs #{NFS_SERVER_IP}:/exports/k8s-volumes /mnt/nfs-storage

          # Add to fstab to mount at boot
          echo "#{NFS_SERVER_IP}:/exports/k8s-volumes /mnt/nfs-storage nfs defaults 0 0" >> /etc/fstab

          echo "=== NFS mounted at /mnt/nfs-storage ==="
          df -h /mnt/nfs-storage
        SHELL

        # Kubernetes provisioning with the Go binary
        vm.vm.provision "shell", inline: <<-SHELL
          set -e
          cp /opt/k8s-provisioner/build/k8s-provisioner-linux-#{ARCH} /usr/local/bin/k8s-provisioner
          chmod +x /usr/local/bin/k8s-provisioner
          mkdir -p /etc/k8s-provisioner
          cp /opt/k8s-provisioner/config.yaml /etc/k8s-provisioner/config.yaml

          k8s-provisioner provision all -c /etc/k8s-provisioner/config.yaml -v 2>&1 | tee /var/log/k8s-provisioner.log
          exit ${PIPESTATUS[0]}
        SHELL

        # After the last worker joins, install all workloads on the control plane.
        # At this point all nodes are in the cluster so DaemonSets spread correctly.
        if vm_config['name'] == "node02"
          vm.vm.provision "shell", inline: <<-SHELL
            set -e
            echo "=== All nodes joined — triggering workload installation on controlplane (192.168.56.10) ==="
            echo "=== (output below comes from controlplane, not from this node) ==="
            apt-get install -y sshpass
            sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 \
              'sudo k8s-provisioner provision workloads -c /etc/k8s-provisioner/config.yaml -v 2>&1 | sudo tee /var/log/k8s-provisioner-workloads.log; exit ${PIPESTATUS[0]}'
          SHELL
        end

        # Label node01 for AI workloads after joining (only if Karpor AI is enabled)
        if vm_config['name'] == "node01"
          vm.vm.provision "shell", inline: <<-SHELL
            # Check if Ollama namespace exists (means Karpor AI with Ollama is enabled)
            apt-get install -y sshpass

            if sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl get namespace ollama' 2>/dev/null; then
              echo "=== Karpor AI with Ollama detected ==="

              echo "=== Labeling node01 for AI workloads ==="
              sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl label node node01 workload/ai=true --overwrite'

              echo "=== Restarting Ollama to move to node01 ==="
              sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl rollout restart deployment/ollama -n ollama'

              echo "=== Waiting for Ollama pod to be ready ==="
              for i in {1..60}; do
                if sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl wait --for=condition=Ready pods -l app=ollama -n ollama --timeout=10s' 2>/dev/null; then
                  echo "Ollama pod is ready!"
                  break
                fi
                echo "Waiting for Ollama pod... ($i/60)"
                sleep 5
              done

              echo "=== Waiting for Ollama model to be available ==="
              for i in {1..60}; do
                if sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl exec -n ollama deployment/ollama -- ollama list 2>/dev/null | grep -q llama'; then
                  echo "Ollama model is ready!"
                  break
                fi
                echo "Waiting for model... ($i/60)"
                sleep 5
              done

              echo "=== Restarting Karpor server to reconnect AI ==="
              sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl rollout restart deployment/karpor-server -n karpor'

              echo "=== Waiting for Karpor server to be ready ==="
              for i in {1..30}; do
                if sshpass -p 'vagrant' ssh -o StrictHostKeyChecking=no vagrant@192.168.56.10 'sudo kubectl wait --for=condition=Ready pods -l app.kubernetes.io/component=karpor-server -n karpor --timeout=10s' 2>/dev/null; then
                  echo "Karpor server is ready! AI should be functional."
                  break
                fi
                echo "Waiting for Karpor server... ($i/30)"
                sleep 5
              done
            else
              echo "=== Ollama not installed, skipping AI configuration ==="
            fi
          SHELL
        end

        # Configure kubectl autocomplete and aliases
        vm.vm.provision "shell", inline: <<-SHELL
          set -e
          echo "=== Configuring kubectl autocomplete and aliases ==="

          # Configuration for the vagrant user
          cat >> /home/vagrant/.bashrc <<'BASHRC'

# Kubectl autocomplete
source <(kubectl completion bash)

# Aliases
alias k=kubectl
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgn='kubectl get nodes'
alias kga='kubectl get all'
alias kgaa='kubectl get all -A'
alias kd='kubectl describe'
alias kl='kubectl logs'
alias kx='kubectl exec -it'
alias ka='kubectl apply -f'
alias kdel='kubectl delete -f'

# Autocomplete for the k alias
complete -o default -F __start_kubectl k

# Quick namespace switch
alias kn='kubectl config set-context --current --namespace'

# Dry-run helper
export do='--dry-run=client -o yaml'
BASHRC
          chown vagrant:vagrant /home/vagrant/.bashrc

          # Same configuration for root
          cat >> /root/.bashrc <<'BASHRC'

# Kubectl autocomplete
source <(kubectl completion bash)

# Aliases
alias k=kubectl
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgn='kubectl get nodes'
alias kga='kubectl get all'
alias kgaa='kubectl get all -A'
alias kd='kubectl describe'
alias kl='kubectl logs'
alias kx='kubectl exec -it'
alias ka='kubectl apply -f'
alias kdel='kubectl delete -f'

# Autocomplete for the k alias
complete -o default -F __start_kubectl k

# Quick namespace switch
alias kn='kubectl config set-context --current --namespace'

# Dry-run helper
export do='--dry-run=client -o yaml'
BASHRC

          echo "=== Autocomplete and aliases configured ==="
        SHELL
      end
    end
  end
end